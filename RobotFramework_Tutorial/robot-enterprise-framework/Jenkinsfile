pipeline {
    agent any

    environment {
        DOCKER_USER   = 'pvmrmoorthy'
        OPENSHIFT_URL = 'https://api.rm3.7wse.p1.openshiftapps.com:6443'
        OS_PROJECT    = 'pvmrmoorthy-dev'
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                git branch: 'master', url: 'https://github.com/crazydude552/robot-enterprise-framework.git'
            }
        }

        stage('Build & Push Docker Images') {
            steps {
                dir('RobotFramework_Tutorial/robot-enterprise-framework') {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                        sh '''
                            echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin

                            # Build and push FastAPI app image
                            docker build --no-cache -t ${DOCKER_USER}/fastapi-app:latest .
                            docker push ${DOCKER_USER}/fastapi-app:latest

                            # Build and push Robot Framework runner image
                            docker build --no-cache -f Dockerfile.rf -t ${DOCKER_USER}/rf-runner:latest .
                            docker push ${DOCKER_USER}/rf-runner:latest
                        '''
                    }
                }
            }
        }

        stage('Deploy FastAPI to OpenShift') {
            steps {
                withCredentials([string(credentialsId: 'openshift-token', variable: 'OS_TOKEN')]) {
                    sh '''
                        oc login --token=${OS_TOKEN} --server=${OPENSHIFT_URL}
                        oc project ${OS_PROJECT}

                        oc create deployment fastapi-app --image=${DOCKER_USER}/fastapi-app:latest --dry-run=client -o yaml | oc apply -f -
                        oc expose deployment/fastapi-app --port=8000 --dry-run=client -o yaml | oc apply -f -
                        oc create route edge fastapi-app --service=fastapi-app --dry-run=client -o yaml | oc apply -f -

                        # Force deployment update
                        oc rollout restart deployment/fastapi-app
                        oc rollout status deployment/fastapi-app --timeout=120s
                    '''
                }
            }
        }

        stage('Execute Robot Framework Tests') {
            steps {
                withCredentials([string(credentialsId: 'openshift-token', variable: 'OS_TOKEN')]) {
                    sh '''
                        oc login --token=${OS_TOKEN} --server=${OPENSHIFT_URL}
                        oc project ${OS_PROJECT}

                        oc delete job rf-test-job --ignore-not-found=true

                        # Create job to execute test suite
                        oc create job rf-test-job --image=${DOCKER_USER}/rf-runner:latest -- \
                            robot --pythonpath . --variablefile config/env_local.py --outputdir /app/results suites/

                        echo "Waiting for Robot Framework tests to finish..."
                        oc wait --for=condition=complete job/rf-test-job --timeout=180s || true
                    '''
                }
            }
        }
    }

    post {
        always {
            withCredentials([string(credentialsId: 'openshift-token', variable: 'OS_TOKEN')]) {
                sh '''
                    mkdir -p ${WORKSPACE}/results

                    oc login --token=${OS_TOKEN} --server=${OPENSHIFT_URL} > /dev/null 2>&1
                    POD_NAME=$(oc get pods -l job-name=rf-test-job -n ${OS_PROJECT} --sort-by='.metadata.creationTimestamp' -o jsonpath='{.items[-1].metadata.name}')

                    if [ -n "$POD_NAME" ]; then
                        echo "Fetching logs from $POD_NAME..."
                        oc logs $POD_NAME -n ${OS_PROJECT} --tail=200 || true
                    else
                        echo "No pod found for rf-test-job"
                    fi
                '''
            }

            // Publish reports on Jenkins build page
            robot(
                outputPath: 'results',
                outputFileName: 'output.xml',
                reportFileName: 'report.html',
                logFileName: 'log.html',
                passThreshold: 100.0,
                unstableThreshold: 80.0
            )
        }
    }
}