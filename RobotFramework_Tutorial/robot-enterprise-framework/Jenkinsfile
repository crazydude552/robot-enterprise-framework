pipeline {
    agent any

    environment {
        DOCKER_USER   = 'pvmrmoorthy' // Your Docker Hub username
        OPENSHIFT_URL = 'https://api.rm3.7wse.p1.openshiftapps.com:6443' // Your Sandbox API URL
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                git branch: 'master', url: 'https://github.com/crazydude552/robot-enterprise-framework.git'
            }
        }

        stage('Build & Push Docker Images') {
    steps {
        dir('RobotFramework_Tutorial/robot-enterprise-framework') {
            withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                sh '''
                    echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin

                    # Force a clean build without cache so pandas is installed
                    docker build --no-cache -t pvmrmoorthy/fastapi-app:latest .
                    docker push pvmrmoorthy/fastapi-app:latest

                    docker build --no-cache -f Dockerfile.rf -t pvmrmoorthy/rf-runner:latest .
                    docker push pvmrmoorthy/rf-runner:latest
                '''
            }
        }
    }
}

        stage('Deploy FastAPI to OpenShift') {
    steps {
        withCredentials([string(credentialsId: 'openshift-token', variable: 'OS_TOKEN')]) {
            sh '''
                oc login --token=${OS_TOKEN} --server=https://api.rm3.7wse.p1.openshiftapps.com:6443
                oc project pvmrmoorthy-dev

                oc create deployment fastapi-app --image=pvmrmoorthy/fastapi-app:latest --dry-run=client -o yaml | oc apply -f -
                oc expose deployment/fastapi-app --port=8000 --dry-run=client -o yaml | oc apply -f -
                oc create route edge fastapi-app --service=fastapi-app --dry-run=client -o yaml | oc apply -f -

                # Force deployment to replace crashing pods with the newly pushed image
                oc rollout restart deployment/fastapi-app
                oc rollout status deployment/fastapi-app --timeout=120s
            '''
        }
    }
}

        stage('Execute Robot Framework Tests') {
    steps {
        withCredentials([string(credentialsId: 'oc-token', variable: 'OS_TOKEN')]) {
            sh '''
                oc delete job rf-test-job --ignore-not-found=true

                # 1. Create job using your specific Robot Framework command
                # Note: Linux paths use forward slashes (/) instead of backslashes (\\)
                oc create job rf-test-job --image=pvmrmoorthy/rf-runner:latest -- \
                    robot --pythonpath . --variablefile config/env_local.py --outputdir /app/results suites/

                # 2. Wait for the test job to complete or fail
                echo "Waiting for Robot Framework tests to finish..."
                oc wait --for=condition=complete job/rf-test-job --timeout=180s || true
            '''
        }
    }
    post {
        always {
            sh '''
                # Create a local results directory in the Jenkins workspace
                mkdir -p ${WORKSPACE}/results

                # Find the pod name generated by the job
                POD_NAME=$(oc get pods -l job-name=rf-test-job -n pvmrmoorthy-dev --sort-by='.metadata.creationTimestamp' -o jsonpath='{.items[-1].metadata.name}')

                if [ -n "$POD_NAME" ]; then
                    echo "Copying report files from pod: $POD_NAME..."
                    # Copy /app/results contents from the pod into Jenkins workspace
                    oc cp pvmrmoorthy-dev/$POD_NAME:/app/results ${WORKSPACE}/results || true
                else
                    echo "No pod found for rf-test-job"
                fi
            '''

            // 3. Publish reports on the Jenkins build page
            robot(
                outputPath: 'results',
                outputFileName: 'output.xml',
                reportFileName: 'report.html',
                logFileName: 'log.html',
                passThreshold: 100.0,
                unstableThreshold: 80.0
            )
        }
    }
}
    }
}