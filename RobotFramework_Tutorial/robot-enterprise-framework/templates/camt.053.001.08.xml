<?xml version="1.0" encoding="UTF-8"?>
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:camt.053.001.08">
    <BkToCstmrStmt>
        <GrpHdr>
            <MsgId>${MsgId}</MsgId>
            <CreDtTm>${CreDtTm}</CreDtTm>
        </GrpHdr>
        <Stmt>
            <Id>${StmtId}</Id>
            <StmtPgntn>
                <PgNb>1</PgNb>
                <LastPgInd>true</LastPgInd>
            </StmtPgntn>
            <Acct>
                <Id>
                    <IBAN>${Iban}</IBAN>
                </Id>
            </Acct>
            <Bal>
                <Tp>
                    <CdOrPrtry>
                        <Cd>OPBD</Cd>
                    </CdOrPrtry>
                </Tp>
                <Amt Ccy="${Ccy}">${OpeningBal}</Amt>
                <CdtDbtInd>CRDT</CdtDbtInd>
                <Dt>
                    <Dt>${StmtDate}</Dt>
                </Dt>
            </Bal>
            <Bal>
                <Tp>
                    <CdOrPrtry>
                        <Cd>CLBD</Cd>
                    </CdOrPrtry>
                </Tp>
                <Amt Ccy="${Ccy}">${ClosingBal}</Amt>
                <CdtDbtInd>CRDT</CdtDbtInd>
                <Dt>
                    <Dt>${StmtDate}</Dt>
                </Dt>
            </Bal>
            <Ntry>
                <Amt Ccy="${Ccy}">${TxAmt}</Amt>
                <CdtDbtInd>${TxType}</CdtDbtInd>
                <Sts>BOOK</Sts>
                <NtryDtls>
                    <TxDtls>
                        <Refs>
                            <EndToEndId>${EndToEndId}</EndToEndId>
                            <UETR>${UETR}</UETR>
                        </Refs>
                    </TxDtls>
                </NtryDtls>
            </Ntry>
        </Stmt>
    </BkToCstmrStmt>
</Document>